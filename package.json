{
  "name": "frontierbrain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "vgc": "node tools/cli.ts",
    "test": "node --test tools/tests/*.test.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "daily": "node tools/cli.ts daily",
    "weekly": "node tools/cli.ts weekly",
    "dev": "node tools/dev.mjs",
    "build": "vite build",
    "test:ui": "node --test tools/tests/workbench.test.ts",
    "seed:ui": "node tools/workbench-seed.ts",
    "postinstall": "node tools/build-dependencies.mjs",
    "build:api": "node tools/build-api.mjs",
    "seed:hosted": "node tools/hosted-seed.ts",
    "dev:hosted": "node tools/dev.mjs --hosted"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@smogon/calc": "0.12.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/functions": "^3.9.11",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^0.460.0",
    "pokemon-showdown": "https://codeload.github.com/smogon/pokemon-showdown/tar.gz/c046106cbe075931b1ff8d8b800ff5be47a85f96",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.170.0",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3"
  }
}
