{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && node tools/build-api.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "{package.json,build/api/**,knowledge/mechanics/**,knowledge/regulations/**,knowledge/sources/**,knowledge/samples/**,node_modules/pokemon-showdown/dist/**,node_modules/pokemon-showdown/config/**}"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/oauth/consent",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "syd1"
  ]
}
