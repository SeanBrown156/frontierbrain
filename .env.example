# Where your teams, replays and reports are stored. Defaults to this folder (gitignored paths).
# APP_DATA=../my-vgc-data

# Optional: in-app assistant (Ask Frontier Brain). Your key, your usage.
# OPENAI_API_KEY=sk-...

# Hosted mode (Supabase). With these set, `npm run dev` runs like the hosted site: sign-in, guests, per-user rows.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...      # server only: shared-data cache writes and `npm run seed:hosted`
